<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="30dp"
    android:paddingEnd="30dp"
    android:paddingTop="55dp"
    android:paddingBottom="30dp"
    android:gravity="center_horizontal"
    android:background="#F7FAF8">

    <!-- Logo -->
    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="50dp"
        android:src="@drawable/solar_advisor_logo"
        android:contentDescription="Logo Solar Advisor CI"
        android:scaleType="fitCenter" />

    <!-- Titre -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="Bienvenue à nouveau"
        android:textColor="#166534"
        android:textSize="25sp"
        android:textStyle="bold" />

    <!-- Sous-titre -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Connectez-vous pour accéder à votre espace Solar Advisor CI"
        android:textColor="#374151"
        android:textSize="15sp"
        android:gravity="center" />

    <!-- Label email -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="Adresse e-mail"
        android:textColor="#374151"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Email -->
    <EditText
        android:id="@+id/edtEmail"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="8dp"
        android:hint="Entrez votre adresse e-mail"
        android:inputType="textEmailAddress"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        android:background="@drawable/edit_text_background" />

    <!-- Label mot de passe -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Mot de passe"
        android:textColor="#374151"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Mot de passe -->
    <EditText
        android:id="@+id/edtPassword"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="8dp"
        android:hint="Entrez votre mot de passe"
        android:inputType="textPassword"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        android:background="@drawable/edit_text_background" />

    <!-- Mot de passe oublié -->
    <TextView
        android:id="@+id/txtForgotPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Mot de passe oublié ?"
        android:textColor="#166534"
        android:textSize="14sp"
        android:gravity="end"
        android:clickable="true"
        android:focusable="true" />

    <!-- Bouton connexion -->
    <Button
        android:id="@+id/btnConnexion"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="30dp"
        android:text="SE CONNECTER"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#16A34A" />

    <!-- Inscription -->
    <TextView
        android:id="@+id/txtInscription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:text="Vous n'avez pas encore de compte ?  S'inscrire"
        android:textColor="#166534"
        android:textSize="14sp"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>