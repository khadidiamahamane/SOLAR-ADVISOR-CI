<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAF9"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="35dp"
        android:paddingBottom="30dp">

        <!-- Retour -->

        <TextView
            android:id="@+id/btnRetourEvaluation2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="‹"
            android:textColor="#166534"
            android:textSize="38sp"
            android:textStyle="bold" />

        <!-- Titre -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Évaluation énergétique"
            android:textColor="#111827"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- Description -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Quelques informations nous permettront de mieux comprendre vos besoins."
            android:textColor="#6B7280"
            android:textSize="15sp" />

        <!-- Progression -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Étape 2 sur 4"
            android:textColor="#16A34A"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Question principale -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Quelle information pouvez-vous fournir ?"
            android:textColor="#111827"
            android:textSize="19sp"
            android:textStyle="bold" />

        <!-- Choix consommation / facture -->

        <RadioGroup
            android:id="@+id/radioGroupInformation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp">

            <RadioButton
                android:id="@+id/radioConsommation"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="Je connais ma consommation électrique"
                android:textColor="#374151"
                android:textSize="15sp" />

            <RadioButton
                android:id="@+id/radioFacture"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="Je connais plutôt ma facture d'électricité"
                android:textColor="#374151"
                android:textSize="15sp" />

        </RadioGroup>

        <!-- Zone consommation -->

        <LinearLayout
            android:id="@+id/layoutConsommation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Votre consommation mensuelle"
                android:textColor="#111827"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editConsommation"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="8dp"
                android:background="@android:drawable/edit_text"
                android:hint="Ex : 850"
                android:inputType="numberDecimal"
                android:paddingStart="15dp"
                android:paddingEnd="15dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="kWh / mois"
                android:textColor="#6B7280"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Zone facture -->

        <LinearLayout
            android:id="@+id/layoutFacture"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Votre facture mensuelle moyenne"
                android:textColor="#111827"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editFacture"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="8dp"
                android:background="@android:drawable/edit_text"
                android:hint="Ex : 75000"
                android:inputType="number"
                android:paddingStart="15dp"
                android:paddingEnd="15dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="FCFA / mois"
                android:textColor="#6B7280"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Coupures -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="À quelle fréquence votre structure subit-elle des coupures ?"
            android:textColor="#111827"
            android:textSize="17sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/radioGroupCoupures"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <RadioButton
                android:id="@+id/radioRarement"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Rarement"
                android:textColor="#374151"
                android:textSize="15sp" />

            <RadioButton
                android:id="@+id/radioParfois"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Parfois"
                android:textColor="#374151"
                android:textSize="15sp" />

            <RadioButton
                android:id="@+id/radioSouvent"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Souvent"
                android:textColor="#374151"
                android:textSize="15sp" />

        </RadioGroup>

        <!-- Continuer -->

        <Button
            android:id="@+id/btnContinuerEvaluation2"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="25dp"
            android:backgroundTint="#16A34A"
            android:text="Continuer"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>