<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAF9"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="35dp"
        android:paddingBottom="30dp">

        <!-- Retour -->

        <TextView
            android:id="@+id/btnRetourEvaluation3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="‹"
            android:textColor="#166534"
            android:textSize="38sp"
            android:textStyle="bold" />

        <!-- Titre -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Évaluation énergétique"
            android:textColor="#111827"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- Description -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Indiquez les principaux équipements utilisés dans votre structure."
            android:textColor="#6B7280"
            android:textSize="15sp" />

        <!-- Progression -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Étape 3 sur 4"
            android:textColor="#16A34A"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Question -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Quels équipements utilisez-vous principalement ?"
            android:textColor="#111827"
            android:textSize="19sp"
            android:textStyle="bold" />

        <!-- Climatisation -->

        <CheckBox
            android:id="@+id/checkClimatisation"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="10dp"
            android:text="Climatisation"
            android:textColor="#374151"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/editClimatisation"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Quantité"
            android:inputType="number"
            android:paddingStart="15dp"
            android:visibility="gone" />

        <!-- Éclairage -->

        <CheckBox
            android:id="@+id/checkEclairage"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Éclairage"
            android:textColor="#374151"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/editEclairage"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Quantité"
            android:inputType="number"
            android:paddingStart="15dp"
            android:visibility="gone" />

        <!-- Réfrigération -->

        <CheckBox
            android:id="@+id/checkRefrigeration"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Réfrigérateur / Congélateur"
            android:textColor="#374151"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/editRefrigeration"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Quantité"
            android:inputType="number"
            android:paddingStart="15dp"
            android:visibility="gone" />

        <!-- Ordinateurs -->

        <CheckBox
            android:id="@+id/checkOrdinateurs"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Ordinateurs"
            android:textColor="#374151"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/editOrdinateurs"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Quantité"
            android:inputType="number"
            android:paddingStart="15dp"
            android:visibility="gone" />

        <!-- Pompes -->

        <CheckBox
            android:id="@+id/checkPompes"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Pompes à eau"
            android:textColor="#374151"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/editPompes"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Quantité"
            android:inputType="number"
            android:paddingStart="15dp"
            android:visibility="gone" />

        <!-- Autre -->

        <CheckBox
            android:id="@+id/checkAutre"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Autre équipement"
            android:textColor="#374151"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/editAutre"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Précisez l'équipement"
            android:inputType="text"
            android:paddingStart="15dp"
            android:visibility="gone" />

        <!-- Durée -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Durée moyenne d'utilisation"
            android:textColor="#111827"
            android:textSize="18sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/radioGroupDuree"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <RadioButton
                android:id="@+id/radioMoins4"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Moins de 4 h / jour"
                android:textColor="#374151"
                android:textSize="15sp" />

            <RadioButton
                android:id="@+id/radio4a8"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="4 à 8 h / jour"
                android:textColor="#374151"
                android:textSize="15sp" />

            <RadioButton
                android:id="@+id/radioPlus8"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Plus de 8 h / jour"
                android:textColor="#374151"
                android:textSize="15sp" />

        </RadioGroup>

        <!-- Continuer -->

        <Button
            android:id="@+id/btnContinuerEvaluation3"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="25dp"
            android:backgroundTint="#16A34A"
            android:text="Continuer"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>