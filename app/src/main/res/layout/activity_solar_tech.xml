<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="30dp"
        android:paddingBottom="30dp">


        <!-- ========================= -->
        <!-- RETOUR -->
        <!-- ========================= -->

        <TextView
            android:id="@+id/btnRetourSolarTech"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="‹"
            android:textColor="#1F2937"
            android:textSize="38sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />


        <!-- ========================= -->
        <!-- INFORMATIONS FOURNISSEUR -->
        <!-- ========================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">


            <!-- LOGO -->

            <LinearLayout
                android:layout_width="125dp"
                android:layout_height="112dp"
                android:background="@drawable/bg_logo_solartech"
                android:gravity="center"
                android:padding="10dp">

                <ImageView
                    android:id="@+id/imgLogoSolarTechDetail"
                    android:layout_width="95dp"
                    android:layout_height="95dp"
                    android:contentDescription="Logo SolarTech CI"
                    android:scaleType="centerInside"
                    android:src="@drawable/logo_solartech_ci" />

            </LinearLayout>


            <!-- NOM + NOTE -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SolarTech CI"
                    android:textColor="#173B68"
                    android:textSize="22sp"
                    android:textStyle="bold" />


                <!-- Badge -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:background="@drawable/bg_badge_verified"
                    android:text="✓ Partenaire vérifié"
                    android:textColor="#00A878"
                    android:textSize="12sp"
                    android:textStyle="bold" />


                <!-- Étoiles -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="★★★★★  4,8 (56 avis)"
                    android:textColor="#00A878"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>


        <!-- ========================= -->
        <!-- DESCRIPTION -->
        <!-- ========================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Spécialisée dans l'installation de systèmes solaires et la maintenance énergétique pour les entreprises et institutions."
            android:textColor="#52657D"
            android:textSize="14sp"
            android:textStyle="bold"
            android:lineSpacingExtra="2dp" />


        <!-- ========================= -->
        <!-- SERVICES -->
        <!-- ========================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Service proposés"
            android:textColor="#173B68"
            android:textSize="15sp"
            android:textStyle="bold" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:weightSum="4">


            <!-- Installation -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:gravity="center"
                    android:background="@drawable/bg_service"
                    android:text="☀"
                    android:textColor="#173B68"
                    android:textSize="27sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:gravity="center"
                    android:text="Installation&#10;solaire"
                    android:textColor="#52657D"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- Maintenance -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:gravity="center"
                    android:background="@drawable/bg_service"
                    android:text="ϟ"
                    android:textColor="#16A34A"
                    android:textSize="30sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:gravity="center"
                    android:text="Maintenance&#10;préventive"
                    android:textColor="#52657D"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- Dépannage -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:gravity="center"
                    android:background="@drawable/bg_service"
                    android:text="⚙"
                    android:textColor="#173B68"
                    android:textSize="28sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:gravity="center"
                    android:text="Dépannage&#10;rapide"
                    android:textColor="#52657D"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- Conseil -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:gravity="center"
                    android:background="@drawable/bg_service"
                    android:text="✓"
                    android:textColor="#00A878"
                    android:textSize="28sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:gravity="center"
                    android:text="Conseil &amp;&#10;Suivi"
                    android:textColor="#52657D"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>


        <!-- ========================= -->
        <!-- ZONES D'INTERVENTION -->
        <!-- ========================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Zones d’intervention"
            android:textColor="#173B68"
            android:textSize="15sp"
            android:textStyle="bold" />


        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:background="@drawable/bg_zone"
                    android:text="Abidjan"
                    android:textColor="#00A878"
                    android:textSize="12sp"
                    android:textStyle="bold" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:background="@drawable/bg_zone"
                    android:text="Yamoussoukro"
                    android:textColor="#00A878"
                    android:textSize="12sp"
                    android:textStyle="bold" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:background="@drawable/bg_zone"
                    android:text="Bouaké"
                    android:textColor="#00A878"
                    android:textSize="12sp"
                    android:textStyle="bold" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:background="@drawable/bg_zone"
                    android:text="San-Pédro"
                    android:textColor="#00A878"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </HorizontalScrollView>


        <!-- ========================= -->
        <!-- 3 IMAGES -->
        <!-- ========================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="95dp"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:weightSum="3">


            <ImageView
                android:id="@+id/imgSolarTech1"
                android:layout_width="0dp"
                android:layout_height="95dp"
                android:layout_weight="1"
                android:layout_marginEnd="7dp"
                android:contentDescription="Installation SolarTech"
                android:scaleType="centerCrop"
                android:src="@drawable/solartech_image1" />


            <ImageView
                android:id="@+id/imgSolarTech2"
                android:layout_width="0dp"
                android:layout_height="95dp"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:contentDescription="Équipe SolarTech"
                android:scaleType="centerCrop"
                android:src="@drawable/solartech_image2" />


            <ImageView
                android:id="@+id/imgSolarTech3"
                android:layout_width="0dp"
                android:layout_height="95dp"
                android:layout_weight="1"
                android:layout_marginStart="7dp"
                android:contentDescription="Panneaux solaires SolarTech"
                android:scaleType="centerCrop"
                android:src="@drawable/solartech_image3" />

        </LinearLayout>


        <!-- ========================= -->
        <!-- BOUTON CONTACT -->
        <!-- ========================= -->

        <Button
            android:id="@+id/btnEntrerContact"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="#3BC79A"
            android:text="Entrer en contact"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />


        <!-- ========================= -->
        <!-- SECURITE -->
        <!-- ========================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="🔒 Vos informations sont sécurisées"
            android:textColor="#64748B"
            android:textSize="12sp" />

    </LinearLayout>

</ScrollView>